rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── دوال مساعدة ───────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function currentUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() &&
             currentUserData().role in ['superAdmin', 'subAdmin'];
    }

    function isSuperAdmin() {
      return isSignedIn() &&
             currentUserData().role == 'superAdmin';
    }

    // ─── مجموعة المستخدمين ──────────────────────────────────────────────
    match /users/{userId} {
      allow read: if request.auth.uid == userId || isSuperAdmin();

      allow create: if request.auth.uid == userId
                    && (!('role' in request.resource.data)
                        || request.resource.data.role == 'user');

      allow update: if (request.auth.uid == userId
                        && !('role' in request.resource.data.diff(resource.data).affectedKeys()))
                    || isSuperAdmin();

      allow delete: if isSuperAdmin();

      // المفضلة — subcollection
      match /favorites/{favId} {
        allow read, write: if request.auth.uid == userId;
      }

      // العناوين — subcollection
      match /addresses/{addressId} {
        allow read, write: if request.auth.uid == userId;
      }
    }

    // ─── مجموعة المنتجات ────────────────────────────────────────────────
    match /products/{productId} {
      allow read: if true;                    // الكل يقرأ المنتجات
      allow create, update: if isAdmin();
      allow delete: if isSuperAdmin();
    }

    // ─── مجموعة الفئات ──────────────────────────────────────────────────
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── مجموعة الطلبات ─────────────────────────────────────────────────
    match /orders/{orderId} {
      allow read: if isSignedIn() &&
                  (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isSuperAdmin();

      // ── رسائل الشات داخل كل طلب ──
      match /messages/{messageId} {
        // القراءة: صاحب الطلب أو الأدمن
        allow read: if isSignedIn() &&
                    (get(/databases/$(database)/documents/orders/$(orderId)).data.userId
                        == request.auth.uid
                     || isAdmin());
        // الإنشاء: صاحب الطلب أو الأدمن، senderId يجب أن يطابق uid
        // أو 'system' للرد التلقائي (يُكتب من الـ datasource بعد رسالة المستخدم)
        allow create: if isSignedIn() &&
                      (request.resource.data.senderId == request.auth.uid
                       || request.resource.data.senderId == 'system'
                       || isAdmin());
      }
    }

    // ─── مجموعة الإشعارات ───────────────────────────────────────────────
    // ⚠️ الإشعارات تستخدم forUserId و forRole للتوجيه (وليس userId)
    match /notifications/{notificationId} {
      // القراءة: المستخدم يقرأ إشعاراته الموجَّهة له (forUserId) أو
      // إشعارات الإدمن إذا كان هو نفسه أدمن (forRole == 'admin')
      allow read: if isSignedIn() &&
                  (resource.data.forUserId == request.auth.uid
                   || (resource.data.forRole == 'admin' && isAdmin()));

      // الإنشاء: أي مستخدم مسجَّل دخول (مطلوب لـ:
      //   - إنشاء طلب جديد → إشعار للأدمن
      //   - إرسال رسالة شات → إشعار للطرف الآخر
      //   - الأدمن يحدّث حالة طلب → إشعار للعميل)
      allow create: if isSignedIn();

      // التحديث: المستلم يستطيع التحديث (لتعليم كمقروء) + grouping
      // chat notifications + الأدمن يستطيع كل شيء
      allow update: if isSignedIn() &&
                    (resource.data.forUserId == request.auth.uid
                     || (resource.data.forRole == 'admin' && isAdmin())
                     || isAdmin());

      allow delete: if isSignedIn() &&
                    (resource.data.forUserId == request.auth.uid || isAdmin());
    }

    // ─── الكوبونات ──────────────────────────────────────────────────────
    // إنشاء/تعديل/حذف الكوبونات → superAdmin فقط (لا subAdmin).
    // القراءة → أي مستخدم مسجَّل، لأن التحقق من الكوبون عند الدفع
    // (findByCode) يتطلب قراءته. أي مستخدم يقدر يستخدم كوبون لو يعرف كوده.
    match /coupons/{couponId} {
      allow read: if isSignedIn();

      allow create, delete: if isSuperAdmin();

      // التحديث:
      //  - superAdmin: أي تعديل (تفعيل/إيقاف/تعديل القيمة…)
      //  - أي مستخدم مسجَّل: فقط زيادة usedCount بمقدار 1 (عند استخدام الكوبون
      //    في الدفع) — لا يقدر يغيّر أي حقل آخر.
      allow update: if isSuperAdmin()
                    || (isSignedIn()
                        && request.resource.data.diff(resource.data)
                             .affectedKeys().hasOnly(['usedCount'])
                        && request.resource.data.usedCount
                             == resource.data.usedCount + 1);
    }

    // ─── سجلّ استخدام الكوبونات ──────────────────────────────────────────
    // كل مستخدم ينشئ/يقرأ redemptions الخاصة به فقط؛ superAdmin يقرأ الكل.
    match /coupon_redemptions/{redemptionId} {
      allow read: if isSignedIn() &&
                  (resource.data.userId == request.auth.uid || isSuperAdmin());
      allow create: if isSignedIn() &&
                    request.resource.data.userId == request.auth.uid;
    }
  }
}
