# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.buildlog/
.history
.svn/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
/build/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# ─── Release Signing — حماية مفاتيح التوقيع من التسريب على Git ─────
# ⚠ ملف key.properties يحتوي على كلمات سر الـ keystore.
# ⚠ ملفات .jks / .keystore هي مفاتيح التوقيع نفسها (فقدانها = فقدان
#    القدرة على تحديث التطبيق على Play Store إلى الأبد).
# احفظ نسخة احتياطية من الـ keystore في مكان آمن خارج المستودع
# (cloud storage مشفّر + USB drive).
android/key.properties
**/*.jks
**/*.keystore

# ─── Store Assets — ملفات سرية وصور المنتجات ──────────────────────────────
# ⚠ Service Account يحتوي على credentials Firebase — لا يُرفع أبداً
store_assets/*firebase*.json
store_assets/serviceAccount.json
# Scripts رفع المنتجات — أدّت غرضها
store_assets/*.py
# صور المنتجات المحلية — مرفوعة على Firebase Storage
store_assets/products/

# تجاهل فايلات المهارات الخاصة بـ AI Extensions
*.md
.windsurf/