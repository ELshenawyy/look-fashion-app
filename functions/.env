# إعدادات عادية (مش أسرار) — يمكن تعديلها مباشرة هنا وإعادة النشر.
# الأسرار الحقيقية (Access Token, Phone Number ID) مخزّنة منفصلة في
# Secret Manager عبر: firebase functions:secrets:set <NAME>

# المزوّد الأساسي لإرسال OTP: whatsapp | textbee | unimatrix | budgetsms | cheapglobalsms
SMS_PROVIDER_PRIMARY=whatsapp

# اسم قالب رسالة المصادقة المعتمد من Meta (بعد موافقة التوثيق)
WHATSAPP_TEMPLATE_NAME=tala_otp

# لغة القالب
WHATSAPP_TEMPLATE_LANG=ar
